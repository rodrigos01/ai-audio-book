{
  "name": "ai-audio-book",
  "version": "1.0.0",
  "description": "AI Audio Book - Turn your books into immersive audio experiences",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev-backend\" \"npm run dev-frontend\"",
    "dev-backend": "npm run dev --prefix backend",
    "dev-frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "deploy": "node scripts/deploy.js",
    "deploy-backend": "node backend/scripts/deploy.js",
    "deploy-frontend": "node frontend/scripts/deploy.js",
    "deploy:parallel": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run deploy-backend\" \"npm run deploy-frontend\""
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "firebase-tools": "^15.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
